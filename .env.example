# Копируйте в .env и заполните значения.
# Docker Compose (для синхронизации restart.sh и docker compose up/logs)
COMPOSE_PROJECT_NAME=mudaroba
# Локальный тег образов. Для staging/production release tooling требует Git SHA.
IMAGE_TAG=local
# Optional backend/workers SHA; empty keeps the legacy single-version setup.
BACKEND_IMAGE_TAG=

# Для продакшена используйте .env.production.example и заполните все переменные.

# База и брокер
POSTGRES_DB=pharmaturk
POSTGRES_USER=pharmaturk
POSTGRES_PASSWORD=pharmaturk
# Адреса ниже предназначены для процессов внутри Docker Compose.
# Для запуска backend на хосте замените postgres:5432 на localhost:5433,
# redis на localhost и qdrant ниже на localhost.
DATABASE_URL=postgres://pharmaturk:pharmaturk@postgres:5432/pharmaturk
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_URL=redis://redis:6379/0
# Кэш Django живёт в отдельном redis-cache (allkeys-lru); docker-compose.yml
# задаёт REDIS_CACHE_URL сервисам сам и перекрывает это значение.
REDIS_CACHE_URL=redis://redis-cache:6379/0
CELERY_RESULT_BACKEND_URL=redis://redis:6379/2
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
# Брошенные анонимные корзины: retention и размер delete-batch (1..10000).
ANONYMOUS_CART_TTL_DAYS=30
ANONYMOUS_CART_CLEANUP_BATCH_SIZE=500
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=1
# Seed выполняется только по явному запросу (`./restart.sh --with-seed`).
RUN_SEED_CATALOG=0
RUN_MIGRATIONS=1
# Opt in only when this environment is allowed to change Telegram provider state.
REGISTER_TELEGRAM_WEBHOOK_ON_START=0

# AI (Claude — основной для текста, OpenAI — запасной; Qdrant, R2 для медиа)
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Цены моделей для учёта расходов AI, USD за 1M токенов (settings.AI_CONFIG["PRICING"]).
# Не задано = встроенная таблица ниже. JSON заменяет таблицу целиком; пустое значение
# роняет запуск Django (невалидный JSON), поэтому строка закомментирована.
# AI_PRICING_JSON={"gpt-4o-mini":{"input":0.15,"cached_input":0.075,"output":0.60},"gpt-4o":{"input":2.50,"cached_input":1.25,"output":10.00},"text-embedding-3-small":{"input":0.02,"output":0}}

# Qdrant (векторная БД для RAG)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# CoinRemitter — крипто-оплата USDT (TRC20)
COINREMITTER_API_KEY=
COINREMITTER_API_PASSWORD=
COINREMITTER_COIN=USDTTRC20
# Объявлена в settings, но кодом не читается: вебхук сверяется через invoice/get.
# Оставьте пустой.
COINREMITTER_WEBHOOK_SECRET=
# Optional comma-separated source IPs. Populate only when the trusted ingress
# normalizes the real client/provider IP before project Nginx sets X-Real-IP.
# Behind Cloudflare without real-ip normalization, $remote_addr is a CF edge IP.
COINREMITTER_WEBHOOK_IP_WHITELIST=
COINREMITTER_OUTBOX_DISPATCH_INTERVAL_SECONDS=60
COINREMITTER_OUTBOX_DISPATCH_BATCH_SIZE=100
COINREMITTER_OUTBOX_REPUBLISH_SECONDS=300
COINREMITTER_OUTBOX_STALE_SECONDS=180
COINREMITTER_RECONCILIATION_INTERVAL_SECONDS=300
COINREMITTER_RECONCILIATION_BATCH_SIZE=10
COINREMITTER_RECONCILIATION_MIN_AGE_MINUTES=10
# Только для локальной разработки; production settings отклоняют значение 1.
CRYPTO_DUMMY_MODE=0

# Social login (optional in development)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
VK_APP_ID=
VK_APP_SECRET=
NEXT_PUBLIC_VK_APP_ID=
# VK Market sync is separate from VK login.
VK_YML_API=
VK_GROUP_ID=0
VK_USER_TOKEN=

# Публичный URL сайта (canonical, медиа, редирект после оплаты)
# localhost допустим для UI, но callback URL в CoinRemitter не передаётся.
# Стандартные домены ngrok также исключены провайдером из-за interstitial-страницы.
SITE_URL=http://localhost:3001
FRONTEND_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Telegram-уведомления администратору, включая новые отзывы на модерации
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
PRODUCTION_WATCHDOG_ENABLED=false
PRODUCTION_WATCHDOG_BASE_URL=https://mudaroba.com
PRODUCTION_WATCHDOG_INTERVAL_SECONDS=300
PRODUCTION_WATCHDOG_FAILURE_THRESHOLD=2
PRODUCTION_WATCHDOG_REPEAT_SECONDS=3600
PRODUCTION_WATCHDOG_REQUEST_TIMEOUT_SECONDS=10

# === Daily offsite PostgreSQL backup (docs/DB_BACKUP.md) ===
# Separate private bucket and a token limited to it; never the R2_* media keys.
DB_BACKUP_ENABLED=false
DB_BACKUP_S3_ENDPOINT_URL=
DB_BACKUP_S3_REGION=auto
DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_ACCESS_KEY_ID=
DB_BACKUP_S3_SECRET_ACCESS_KEY=
# Optional dead man's switch (healthchecks.io ping URL), pinged after each success.
DB_BACKUP_HEARTBEAT_URL=
# Weekly restore into a throwaway database; needs free disk >= 2 x DB + 4 GiB.
DB_BACKUP_TEST_RESTORE_ENABLED=false

# Команда set_telegram_webhook передаёт это же значение как secret_token;
# без него endpoint закрыт. Используйте минимум 32 допустимых Telegram символа.
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# authenticated — любой авторизованный; purchased — только покупатель доставленного заказа
PRODUCT_REVIEW_ACCESS_POLICY=authenticated

# R2 (Cloudflare) — для медиа и AI (изображения товаров)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_USE_SSL=true

# Обслуживание каталога (ночные задачи Celery).
# catalog.cleanup_orphaned_media удаляет из R2 файлы без ссылок из БД (при DJANGO_DEBUG=1
# пропускается). Если к удалению больше MAX_DELETE файлов или больше MAX_DELETE_PERCENT %
# хранилища, не удаляет ничего и шлёт отчёт в Telegram.
ORPHANED_MEDIA_MAX_DELETE=3000
ORPHANED_MEDIA_MAX_DELETE_PERCENT=10
# Сколько дней товар считается «Новинкой» после добавления: парсер ставит бейдж
# только таким товарам, catalog.expire_new_badges снимает его со старых.
NEW_BADGE_DAYS=30

# Optional enrichment and document/email metadata.
SERPER_API_KEY=
MEDICINE_MEDIA_MIN_WIDTH=400
MEDICINE_MEDIA_MIN_HEIGHT=400
MEDICINE_MEDIA_MAX_PER_PRODUCT=3
COMPANY_NAME=Mudaroba
COMPANY_SUPPORT_EMAIL=
COMPANY_SUPPORT_PHONE=
COMPANY_ADDRESS=
COMPANY_SITE_URL=http://localhost:3001
# Имя сайта в автогенерируемых SEO title/description (книги и fallback-SEO карточек).
# Не задано = COMPANY_NAME. Не оставляйте пустым: пустое значение даёт «Online Bookstore».
# BOOKS_SEO_SITE_NAME=Mudaroba
EMAIL_TIMEOUT=30
EMAIL_API_TIMEOUT=15

# Google Tag Manager (GTM) — сейчас не используется: контейнер пуст, gtm.js не грузится
# (docs/ANALYTICS_EVENTS.md). Формат GTM-...
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 через gtag на сайте — из analytics.google.com (формат G-...)
# Если тот же G-... уже настроен тегом внутри GTM, оставьте пустым, чтобы не дублировать учёт.
NEXT_PUBLIC_GA4_ID=

# Яндекс.Метрика — получить из metrika.yandex.ru
NEXT_PUBLIC_YM_ID=
# Яндекс.Вебмастер (подтверждение прав)
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Backend runtime memory safety. Production backend has a 2 GiB cgroup limit;
# gthread preserves request concurrency without four memory-heavy Django processes.
# Rolling recycle releases retained Pillow/parser native allocator arenas.
# На проде docker-compose.prod.yml задаёт MAX_REQUESTS 2000 ± 500 и перекрывает .env.
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_MAX_REQUESTS=200
GUNICORN_MAX_REQUESTS_JITTER=40

# Прокси для парсеров (турецкий residential/mobile для обхода блокировок Akamai на Zara).
# Активен только при флаге use_proxy в ScraperConfig. Пусто = прямое соединение.
SCRAPER_PROXY_URL=
# PEM bundle CA провайдера, если прокси инспектирует TLS. verify=False запрещён.
# Для Bright Data native proxy используйте port 44445 вместе с immutable CA ниже.
SCRAPER_PROXY_CA_BUNDLE=/app/certs/brightdata_root_ca_44445.crt

# FLO CAPTCHA transport. It is used only by product-card open and cart revalidate,
# never by scheduled/full scraping. Keep disabled until a Web Unlocker zone canary passes.
FLO_WEB_UNLOCKER_ENABLED=false
BRIGHTDATA_WEB_UNLOCKER_API_KEY=
BRIGHTDATA_WEB_UNLOCKER_ZONE=
FLO_WEB_UNLOCKER_COUNTRY=tr
# FLO currently requires browser rendering to return the real page instead of CAPTCHA.
FLO_WEB_UNLOCKER_RENDER=true
# Rendering plus parser-side CAPTCHA/SKU validation handles product and category pages.
# Keep empty: a product-only expectation turns FLO's removed-product redirect into a timeout.
FLO_WEB_UNLOCKER_EXPECT_TEXT=
FLO_WEB_UNLOCKER_TIMEOUT_SECONDS=60
FLO_WEB_UNLOCKER_MAX_RESPONSE_BYTES=10485760

# Dual-write наблюдений parser → ProductSourceOffer. Сначала применить catalog migration 0202.
SOURCE_OFFER_RECORDING_ENABLED=false
# Меньшее значение имеет больший приоритет; per-source JSON переопределяет default.
SOURCE_OFFER_DEFAULT_PRIORITY=100
SOURCE_OFFER_SOURCE_PRIORITIES={"zara":10,"bershka":10,"pullandbear":10,"massimodutti":10,"flo":20,"lcw":20,"ikea":20}

# Live check выключен до source-by-source rollout. Пустой список при true = все adapters.
SOURCE_OFFER_VERIFICATION_ENABLED=false
SOURCE_OFFER_VERIFICATION_SOURCES=zara,bershka,pullandbear,massimodutti,flo,lcw,ikea,ummaland
# Ручные/каталожные источники: никогда не меняют цену и наличие карточки/корзины,
# даже если попали в allowlist выше. Пустое значение снимает эту защиту.
SOURCE_OFFER_MANUAL_ONLY_SOURCES=instagram
SOURCE_OFFER_REQUEST_TIMEOUT_SECONDS=5
SOURCE_OFFER_MAX_RETRIES=1
SOURCE_OFFER_RETRY_BACKOFF_SECONDS=0.1
SOURCE_OFFER_SUCCESS_CACHE_TTL=120
SOURCE_OFFER_ERROR_CACHE_TTL=15
SOURCE_OFFER_SINGLEFLIGHT_WAIT_SECONDS=0.5
SOURCE_OFFER_CIRCUIT_FAILURE_THRESHOLD=5
SOURCE_OFFER_CIRCUIT_RECOVERY_SECONDS=60
SOURCE_OFFER_DEFAULT_CONCURRENCY=4
SOURCE_OFFER_SOURCE_CONCURRENCY={"zara":2,"bershka":2,"pullandbear":2,"massimodutti":2,"akakce":1}
SOURCE_OFFER_DEFAULT_RATE_PER_MINUTE=60
SOURCE_OFFER_SOURCE_RATE_PER_MINUTE={"zara":30,"bershka":30,"pullandbear":30,"massimodutti":30,"akakce":10}
# Асинхронное обновление цены/вариантов при открытии только спарсенной карточки.
PRODUCT_CARD_SOURCE_REFRESH_ENABLED=false
PRODUCT_CARD_SOURCE_REFRESH_SOURCES=zara,bershka,pullandbear,massimodutti,flo,lcw,ikea,ummaland,akakce
PRODUCT_CARD_SOURCE_REFRESH_TIMEOUT_SECONDS=12
PRODUCT_CARD_SOURCE_REFRESH_MAX_RETRIES=1
PRODUCT_CARD_SOURCE_REFRESH_STATE_TTL_SECONDS=300
PRODUCT_CARD_SOURCE_REFRESH_ERROR_TTL_SECONDS=30
PRODUCT_CARD_SOURCE_REFRESH_LOCK_SECONDS=150
# Платный FLO (Web Unlocker): успешно проверенное предложение не запрашивать повторно
# N секунд — ни на карточке, ни в корзине.
PRODUCT_CARD_SOURCE_REFRESH_FRESHNESS_SECONDS={"flo":86400}
PRODUCT_CARD_SOURCE_REFRESH_MIN_PRICE_RATIO=0.05
PRODUCT_CARD_SOURCE_REFRESH_MAX_PRICE_RATIO=20
# Повторный полный парсинг этих источников обновляет контент и медиа, но не цену
# на витрине (цену ведёт менеджер).
SCRAPER_PRICE_REFRESH_DISABLED_SOURCES=instagram
# Project only fresh, conclusive supplier availability into product detail and YML.
SOURCE_OFFER_CATALOG_PROJECTION_ENABLED=false
# Online checkout payments (crypto/card). false = every order is a manager request,
# payment is agreed with the customer via the chosen contact channel.
ORDER_ONLINE_PAYMENTS_ENABLED=false
# Frontend pair (build-time): show payment methods on checkout. Keep in sync with the backend flag.
NEXT_PUBLIC_ONLINE_PAYMENTS_ENABLED=false
# Separate reader/enforcement gate: keep false while only observing live-check metrics.
SOURCE_OFFER_CART_ENFORCEMENT_ENABLED=false
# Empty means live verification is not a supplier reservation and fulfillment
# must confirm every source-backed order line manually.
SOURCE_OFFER_RESERVATION_CAPABLE_SOURCES=
# These types cannot fall back to catalog stock while cart enforcement is enabled.
SOURCE_OFFER_CART_REQUIRED_PRODUCT_TYPES=supplements
# Real supplier adapters only. Never add ilacfiyati: it publishes reference prices,
# not warehouse/shop availability.
SUPPLEMENT_STOCK_ADAPTER_SOURCES=
SUPPLEMENT_STOCK_DISCOVERY_ENABLED=false
SUPPLEMENT_STOCK_DISCOVERY_REQUEST_TIMEOUT_SECONDS=12
SUPPLEMENT_STOCK_DISCOVERY_ENQUEUE_LOCK_SECONDS=60
SUPPLEMENT_STOCK_DISCOVERY_NO_MATCH_TTL_SECONDS=21600
SUPPLEMENT_STOCK_DISCOVERY_ERROR_TTL_SECONDS=300

# Автораспределение лекарств по подкатегориям (ATC-код) при парсинге.
# Only IlacFiyati under the medicine root; explicit task leaves still win.
# Turning this off does not reset existing subcategories.
MEDICINE_CATEGORY_AUTOMATION_ENABLED=false

# On-demand medicine reference-price checks (informational; no stock/cart mutation)
MEDICINE_MARKET_CHECK_ENABLED=false
MEDICINE_MARKET_CHECK_SOURCES=ilacfiyati
MEDICINE_MARKET_CHECK_FRESH_SECONDS=43200
MEDICINE_MARKET_CHECK_ERROR_FRESH_SECONDS=300
MEDICINE_MARKET_CHECK_STALE_RUNNING_SECONDS=180
MEDICINE_MARKET_CHECK_ENQUEUE_LOCK_SECONDS=30
MEDICINE_MARKET_CHECK_GLOBAL_RATE_PER_MINUTE=10
MEDICINE_MARKET_CHECK_SOURCE_CONCURRENCY=2
MEDICINE_MARKET_CHECK_REQUEST_TIMEOUT_SECONDS=15
MEDICINE_MARKET_CHECK_MAX_ANALOGS=50

# On-demand supplement reference-price checks. Sale availability remains separate.
SUPPLEMENT_MARKET_CHECK_ENABLED=false
SUPPLEMENT_MARKET_CHECK_SOURCES=ilacfiyati
SUPPLEMENT_MARKET_CHECK_FRESH_SECONDS=43200
SUPPLEMENT_MARKET_CHECK_ERROR_FRESH_SECONDS=300
SUPPLEMENT_MARKET_CHECK_STALE_RUNNING_SECONDS=180
SUPPLEMENT_MARKET_CHECK_ENQUEUE_LOCK_SECONDS=30
SUPPLEMENT_MARKET_CHECK_GLOBAL_RATE_PER_MINUTE=10
SUPPLEMENT_MARKET_CHECK_SOURCE_CONCURRENCY=2
SUPPLEMENT_MARKET_CHECK_REQUEST_TIMEOUT_SECONDS=15

# Error reporting (optional; PII is disabled in backend settings)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
