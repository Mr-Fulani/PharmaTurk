# Production template. Copy to .env, chmod 600 and replace every CHANGE_ME.
# Never commit the resulting .env.

# Immutable image tag: set to the exact Git SHA being deployed.
IMAGE_TAG=replace-with-full-git-sha
# Backend-only releases pin this separately; IMAGE_TAG remains the frontend SHA.
BACKEND_IMAGE_TAG=

# === Django: mandatory fail-fast values ===
DJANGO_DEBUG=0
# Generate with: openssl rand -base64 48
# This placeholder is intentionally rejected by production settings.
DJANGO_SECRET_KEY=change-me
# Hosts only, no scheme and no wildcard.
DJANGO_ALLOWED_HOSTS=mudaroba.com,www.mudaroba.com

# Origins include the scheme. Add only origins that really call the API.
CSRF_TRUSTED_ORIGINS=https://mudaroba.com,https://www.mudaroba.com
CORS_ALLOWED_ORIGINS=https://mudaroba.com,https://www.mudaroba.com

# Nginx preserves incoming X-Forwarded-Proto=https. This is trustworthy only
# behind Full (strict)/Tunnel with direct origin access restricted. Keep this
# safe profile until that proxy chain is verified; see DEPLOY.md.
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# After the strict-TLS prerequisites are verified, use for example:
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# SECURE_HSTS_PRELOAD=0

# === PostgreSQL and Redis ===
# Compose reads these values directly; DATABASE_URL must contain the same
# database, user and URL-encoded password.
POSTGRES_DB=pharmaturk
POSTGRES_USER=pharmaturk
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://pharmaturk:CHANGE_ME@postgres:5432/pharmaturk
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_URL=redis://redis:6379/0
# Кэш Django живёт в отдельном redis-cache (allkeys-lru); docker-compose.yml
# задаёт REDIS_CACHE_URL сервисам сам и перекрывает это значение.
REDIS_CACHE_URL=redis://redis-cache:6379/0
CELERY_RESULT_BACKEND_URL=redis://redis:6379/2
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
# Daily cleanup deletes only anonymous carts inactive for this many days.
ANONYMOUS_CART_TTL_DAYS=30
ANONYMOUS_CART_CLEANUP_BATCH_SIZE=500

# === Qdrant recommendations ===
# OpenSearch is not part of the current stack.
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Seed is opt-in. Set to 1 only for an intentional first population/recovery,
# then return it to 0 before normal restarts.
RUN_SEED_CATALOG=0
# Release tooling applies migrations once through the ops service.
RUN_MIGRATIONS=0
# Keep provider-side webhook mutation out of ordinary container restarts.
# Register it explicitly with manage.py in the intended environment.
REGISTER_TELEGRAM_WEBHOOK_ON_START=0

# === Public and internal URLs ===
# The checked-in Nginx serves frontend and /api on one origin.
NEXT_PUBLIC_SITE_URL=https://mudaroba.com
SITE_URL=https://mudaroba.com
FRONTEND_SITE_URL=https://mudaroba.com
# INTERNAL_API_BASE=http://backend:8000 is supplied by docker-compose.yml.

# === Cloudflare R2 media (optional for catalog media; required for PDF receipts) ===
USE_R2=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_USE_SSL=true
R2_PREFIX=
R2_BOTO_MAX_POOL_CONNECTIONS=64

# === Обслуживание каталога (ночные задачи Celery) ===
# catalog.cleanup_orphaned_media удаляет из R2 файлы без ссылок из БД. Если к удалению
# больше MAX_DELETE файлов или больше MAX_DELETE_PERCENT % хранилища, не удаляет
# ничего и шлёт отчёт в Telegram (предохранитель после вайпа R2 2026-06-14).
ORPHANED_MEDIA_MAX_DELETE=3000
ORPHANED_MEDIA_MAX_DELETE_PERCENT=10
# Сколько дней товар считается «Новинкой» после добавления: парсер ставит бейдж
# только таким товарам, catalog.expire_new_badges снимает его со старых.
NEW_BADGE_DAYS=30

# === Claude (основной провайдер текста, optional) ===
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-haiku-5-5
# false — не обращаться к OpenAI совсем (ни запасной текст, ни картинки, ни эмбеддинги)
AI_OPENAI_ENABLED=true

# === OpenAI (запасной для текста; картинки, эмбеддинги, Batch API) ===
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Цены моделей для учёта расходов AI, USD за 1M токенов (settings.AI_CONFIG["PRICING"]).
# Не задано = встроенная таблица ниже. JSON заменяет таблицу целиком; пустое значение
# роняет запуск Django (невалидный JSON), поэтому строка закомментирована.
# AI_PRICING_JSON={"gpt-4o-mini":{"input":0.15,"cached_input":0.075,"output":0.60},"gpt-4o":{"input":2.50,"cached_input":1.25,"output":10.00},"text-embedding-3-small":{"input":0.02,"output":0}}

# === CoinRemitter (optional crypto payments) ===
# SITE_URL above generates this public callback:
# https://mudaroba.com/api/payments/crypto/webhook/
# The webhook body is reconciled through authenticated invoice/get; there is
# no shared webhook-secret contract in the current implementation.
COINREMITTER_API_KEY=
COINREMITTER_API_PASSWORD=
COINREMITTER_COIN=USDTTRC20
# Объявлена в settings, но кодом не читается (см. выше: вебхук сверяется через
# invoice/get). Оставьте пустой.
COINREMITTER_WEBHOOK_SECRET=
# Optional allowlist. Enable only after trusted-ingress real-IP normalization;
# otherwise Cloudflare makes $remote_addr an edge IP rather than provider IP.
COINREMITTER_WEBHOOK_IP_WHITELIST=
COINREMITTER_OUTBOX_DISPATCH_INTERVAL_SECONDS=60
COINREMITTER_OUTBOX_DISPATCH_BATCH_SIZE=100
COINREMITTER_OUTBOX_REPUBLISH_SECONDS=300
COINREMITTER_OUTBOX_STALE_SECONDS=180
COINREMITTER_RECONCILIATION_INTERVAL_SECONDS=300
COINREMITTER_RECONCILIATION_BATCH_SIZE=10
COINREMITTER_RECONCILIATION_MIN_AGE_MINUTES=10
# Must remain 0; Django fails fast if enabled with DJANGO_DEBUG=0.
CRYPTO_DUMMY_MODE=0

# === Telegram notifications/login (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# Required (>=32 chars) whenever TELEGRAM_BOT_TOKEN is set; pass the same value
# as secret_token when calling Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Public variables are embedded during frontend image build.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# === Production watchdog (docs/PRODUCTION_MONITORING_RUNBOOK.md) ===
# Задача Beat apps.monitoring.tasks.run_production_watchdog открывает /, /api/live/
# и /api/health/ на BASE_URL и шлёт алерт в Telegram (нужны TELEGRAM_BOT_TOKEN и
# TELEGRAM_CHAT_ID). Runbook требует на проде true; manage.py check не пропустит
# значения вне диапазонов ниже.
PRODUCTION_WATCHDOG_ENABLED=false
# HTTPS-origin без пути.
PRODUCTION_WATCHDOG_BASE_URL=https://mudaroba.com
# Период проверки, 60..3600 с (это же расписание Beat).
PRODUCTION_WATCHDOG_INTERVAL_SECONDS=300
# Алерт после N неудачных проверок подряд, 1..12.
PRODUCTION_WATCHDOG_FAILURE_THRESHOLD=2
# Повтор алерта, пока сбой не прошёл; не меньше INTERVAL.
PRODUCTION_WATCHDOG_REPEAT_SECONDS=3600
# Таймаут одного запроса, 1..10 с.
PRODUCTION_WATCHDOG_REQUEST_TIMEOUT_SECONDS=10

# === Daily offsite PostgreSQL backup (docs/DB_BACKUP.md) ===
# Separate private bucket and a token limited to it; never the R2_* media keys.
DB_BACKUP_ENABLED=false
DB_BACKUP_S3_ENDPOINT_URL=
DB_BACKUP_S3_REGION=auto
DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_ACCESS_KEY_ID=
DB_BACKUP_S3_SECRET_ACCESS_KEY=
# Optional dead man's switch (healthchecks.io ping URL), pinged after each success.
DB_BACKUP_HEARTBEAT_URL=
# Weekly restore into a throwaway database; needs free disk >= 2 x DB + 4 GiB.
DB_BACKUP_TEST_RESTORE_ENABLED=false

# === Google and VK login (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
VK_APP_ID=
VK_APP_SECRET=
NEXT_PUBLIC_VK_APP_ID=
# VK Market sync is separate from VK login.
VK_YML_API=
VK_GROUP_ID=0
VK_USER_TOKEN=
# Сверка каталога ВК с фидом: расписание и порог остановки (docs/VK_YML_FEED.md).
VK_SYNC_ENABLED=false
VK_SYNC_MAX_DELETE_SHARE=0.3

# === Email (optional) ===
DEFAULT_FROM_EMAIL=no-reply@mudaroba.com
SERVER_EMAIL=no-reply@mudaroba.com
EMAIL_ADMIN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
EMAIL_API_TIMEOUT=15
# API alternatives supported by settings: sendgrid, smtp2go or resend.
EMAIL_API_PROVIDER=
EMAIL_API_FROM=
SENDGRID_API_KEY=
SMTP2GO_API_KEY=
RESEND_API_KEY=

# === Company data rendered in receipts/messages ===
COMPANY_NAME=Mudaroba
COMPANY_SUPPORT_EMAIL=support@mudaroba.com
COMPANY_SUPPORT_PHONE=
COMPANY_ADDRESS=
COMPANY_SITE_URL=https://mudaroba.com
# Имя сайта в автогенерируемых SEO title/description (книги и fallback-SEO карточек).
# Не задано = COMPANY_NAME. Не оставляйте пустым: пустое значение даёт «Online Bookstore».
# BOOKS_SEO_SITE_NAME=Mudaroba

# === Optional medicine media enrichment ===
SERPER_API_KEY=
MEDICINE_MEDIA_MIN_WIDTH=400
MEDICINE_MEDIA_MIN_HEIGHT=400
MEDICINE_MEDIA_MAX_PER_PRODUCT=3

# === Other optional integrations ===
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
VAPI_BASE_URL=https://api.vapi.co
VAPI_API_KEY=
# Separator: the empty key above must not consume the next setting in dotenv/scanners.
VAPI_DEFAULT_LANG=en
SCRAPER_PROXY_URL=
# PEM bundle CA провайдера, если прокси инспектирует TLS. verify=False запрещён.
SCRAPER_PROXY_CA_BUNDLE=

# FLO CAPTCHA transport. Paid Web Unlocker requests are permitted only from the
# product-card-open and cart-revalidate paths. Enable after a successful FLO canary.
FLO_WEB_UNLOCKER_ENABLED=false
BRIGHTDATA_WEB_UNLOCKER_API_KEY=
BRIGHTDATA_WEB_UNLOCKER_ZONE=
FLO_WEB_UNLOCKER_COUNTRY=tr
# FLO currently requires browser rendering to return the real page instead of CAPTCHA.
FLO_WEB_UNLOCKER_RENDER=true
# Keep empty. A product-only manual expect cannot distinguish FLO's legitimate
# removed-product category redirect from an unlock failure, and bills failed attempts.
# Parser-side CAPTCHA and exact-SKU checks still fail closed.
FLO_WEB_UNLOCKER_EXPECT_TEXT=
FLO_WEB_UNLOCKER_TIMEOUT_SECONDS=60
FLO_WEB_UNLOCKER_MAX_RESPONSE_BYTES=10485760

# === Supplier source-offer verification ===
# Safe rollout order: recording -> one-source verification -> card/cart -> catalog.
# Supplier background refresh is intentionally not registered or scheduled.
# Never enable verification with an empty allowlist; empty means every registered adapter.
SOURCE_OFFER_RECORDING_ENABLED=false
SOURCE_OFFER_DEFAULT_PRIORITY=100
SOURCE_OFFER_SOURCE_PRIORITIES={"zara":10,"bershka":10,"pullandbear":10,"massimodutti":10,"flo":20,"lcw":20,"ikea":20}
SOURCE_OFFER_VERIFICATION_ENABLED=false
SOURCE_OFFER_VERIFICATION_SOURCES=ikea
# Ручные/каталожные источники: никогда не меняют цену и наличие карточки/корзины,
# даже если попали в allowlist выше. Пустое значение снимает эту защиту.
SOURCE_OFFER_MANUAL_ONLY_SOURCES=instagram
SOURCE_OFFER_REQUEST_TIMEOUT_SECONDS=5
SOURCE_OFFER_MAX_RETRIES=1
SOURCE_OFFER_RETRY_BACKOFF_SECONDS=0.1
SOURCE_OFFER_SUCCESS_CACHE_TTL=120
SOURCE_OFFER_ERROR_CACHE_TTL=15
SOURCE_OFFER_SINGLEFLIGHT_WAIT_SECONDS=0.5
SOURCE_OFFER_CIRCUIT_FAILURE_THRESHOLD=5
SOURCE_OFFER_CIRCUIT_RECOVERY_SECONDS=60
SOURCE_OFFER_DEFAULT_CONCURRENCY=4
# Per-source лимиты (в коде default {} = DEFAULT_* выше). Akakce ходит через платный
# прокси; эти же лимиты действуют для поиска продавца БАДов (SUPPLEMENT_STOCK_DISCOVERY_*).
SOURCE_OFFER_SOURCE_CONCURRENCY={"zara":2,"bershka":2,"pullandbear":2,"massimodutti":2,"akakce":1}
SOURCE_OFFER_DEFAULT_RATE_PER_MINUTE=60
SOURCE_OFFER_SOURCE_RATE_PER_MINUTE={"zara":30,"bershka":30,"pullandbear":30,"massimodutti":30,"akakce":10}
PRODUCT_CARD_SOURCE_REFRESH_ENABLED=false
PRODUCT_CARD_SOURCE_REFRESH_SOURCES=zara,bershka,pullandbear,massimodutti,flo,lcw,ikea,ummaland,akakce
PRODUCT_CARD_SOURCE_REFRESH_TIMEOUT_SECONDS=12
PRODUCT_CARD_SOURCE_REFRESH_MAX_RETRIES=1
PRODUCT_CARD_SOURCE_REFRESH_STATE_TTL_SECONDS=300
PRODUCT_CARD_SOURCE_REFRESH_ERROR_TTL_SECONDS=30
PRODUCT_CARD_SOURCE_REFRESH_LOCK_SECONDS=150
# Платный FLO (Web Unlocker): успешно проверенное предложение не запрашивать повторно
# N секунд — ни на карточке, ни в корзине.
PRODUCT_CARD_SOURCE_REFRESH_FRESHNESS_SECONDS={"flo":86400}
PRODUCT_CARD_SOURCE_REFRESH_MIN_PRICE_RATIO=0.05
PRODUCT_CARD_SOURCE_REFRESH_MAX_PRICE_RATIO=20
# Повторный полный парсинг этих источников обновляет контент и медиа, но не цену
# на витрине (цену ведёт менеджер).
SCRAPER_PRICE_REFRESH_DISABLED_SOURCES=instagram
SOURCE_OFFER_CATALOG_PROJECTION_ENABLED=false
SOURCE_OFFER_CART_ENFORCEMENT_ENABLED=false
# Online checkout payments (crypto/card). false = every order is a manager request.
ORDER_ONLINE_PAYMENTS_ENABLED=false
# Frontend pair (build-time): show payment methods on checkout. Keep in sync with the backend flag.
NEXT_PUBLIC_ONLINE_PAYMENTS_ENABLED=false
# Leave empty until a supplier integration provides an actual reservation guarantee.
SOURCE_OFFER_RESERVATION_CAPABLE_SOURCES=
SOURCE_OFFER_CART_REQUIRED_PRODUCT_TYPES=supplements
# Explicit real supplier stock adapters only; ilacfiyati is reference-price-only.
SUPPLEMENT_STOCK_ADAPTER_SOURCES=
# Поиск продавца БАДа на Akakce по кнопке «Проверить цену и наличие» (Celery
# catalog.discover_supplement_stock_offer). Работает, только если также
# SOURCE_OFFER_VERIFICATION_ENABLED=true, akakce есть в SOURCE_OFFER_VERIFICATION_SOURCES
# и SUPPLEMENT_STOCK_ADAPTER_SOURCES и в БД есть активный ScraperConfig akakce с прокси.
# Ручной прогон — discover_supplement_stock_offers (docs/SOURCE_OFFER_OPERATIONS_RUNBOOK.md).
SUPPLEMENT_STOCK_DISCOVERY_ENABLED=false
# Таймаут запроса к Akakce, 3..20 с.
SUPPLEMENT_STOCK_DISCOVERY_REQUEST_TIMEOUT_SECONDS=12
# Не ставить повторную задачу для того же товара, 10..300 с.
SUPPLEMENT_STOCK_DISCOVERY_ENQUEUE_LOCK_SECONDS=60
# Сколько не искать повторно (60..86400 с): после «нет уверенного совпадения» или
# окончательной ошибки — NO_MATCH, после временной ошибки — ERROR.
SUPPLEMENT_STOCK_DISCOVERY_NO_MATCH_TTL_SECONDS=21600
SUPPLEMENT_STOCK_DISCOVERY_ERROR_TTL_SECONDS=300

# Автораспределение лекарств IlacFiyati по подкатегориям (ATC-код) под корнем
# медикаментов; явные подкатегории задачи парсера важнее. false запрещает только
# новые назначения, уже проставленные подкатегории не сбрасываются.
MEDICINE_CATEGORY_AUTOMATION_ENABLED=false

# Справочная проверка цены лекарства по запросу пользователя (не меняет наличие и корзину).
MEDICINE_MARKET_CHECK_ENABLED=false
MEDICINE_MARKET_CHECK_SOURCES=ilacfiyati
# Сколько считать результат свежим: успешный (60..604800 с) и ошибку (0..3600 с).
MEDICINE_MARKET_CHECK_FRESH_SECONDS=43200
MEDICINE_MARKET_CHECK_ERROR_FRESH_SECONDS=300
# Через сколько зависшая проверка в статусе running считается мёртвой, 30..1800 с.
MEDICINE_MARKET_CHECK_STALE_RUNNING_SECONDS=180
MEDICINE_MARKET_CHECK_ENQUEUE_LOCK_SECONDS=30
MEDICINE_MARKET_CHECK_GLOBAL_RATE_PER_MINUTE=10
MEDICINE_MARKET_CHECK_SOURCE_CONCURRENCY=2
MEDICINE_MARKET_CHECK_REQUEST_TIMEOUT_SECONDS=15
# Сколько аналогов сохранять из ответа источника, 0..200.
MEDICINE_MARKET_CHECK_MAX_ANALOGS=50

# On-demand supplement reference-price observation (does not affect stock/cart).
SUPPLEMENT_MARKET_CHECK_ENABLED=false
SUPPLEMENT_MARKET_CHECK_SOURCES=ilacfiyati
SUPPLEMENT_MARKET_CHECK_FRESH_SECONDS=43200
SUPPLEMENT_MARKET_CHECK_ERROR_FRESH_SECONDS=300
SUPPLEMENT_MARKET_CHECK_STALE_RUNNING_SECONDS=180
SUPPLEMENT_MARKET_CHECK_ENQUEUE_LOCK_SECONDS=30
SUPPLEMENT_MARKET_CHECK_GLOBAL_RATE_PER_MINUTE=10
SUPPLEMENT_MARKET_CHECK_SOURCE_CONCURRENCY=2
SUPPLEMENT_MARKET_CHECK_REQUEST_TIMEOUT_SECONDS=15

# authenticated: any authenticated user; purchased: delivered-order buyer.
PRODUCT_REVIEW_ACCESS_POLICY=authenticated

# === Gunicorn ===
# Читает backend/docker-entrypoint.sh (default 2 воркера gthread × 8 потоков).
# Лимит памяти backend — 2g (docker-compose.yml), воркер держит ≈ 560 МБ, поэтому
# 2 воркера, а не 4: см. docs/PROD_MEMORY.md. Без переменной тоже будет 2.
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
# Перезапуск воркера после N ± jitter запросов (возвращает память ОС). Default в
# entrypoint — 200 ± 40, но docker-compose.prod.yml задаёт backend 2000 ± 500 (PR #101)
# в environment, а это перекрывает .env: на проде меняйте значение там.
# GUNICORN_MAX_REQUESTS=2000
# GUNICORN_MAX_REQUESTS_JITTER=500

# === Frontend analytics (embedded during build) ===
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YM_ID=
