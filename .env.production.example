# Production template. Copy to .env, chmod 600 and replace every CHANGE_ME.
# Never commit the resulting .env.

# Immutable image tag: set to the exact Git SHA being deployed.
IMAGE_TAG=replace-with-full-git-sha

# === Django: mandatory fail-fast values ===
DJANGO_DEBUG=0
# Generate with: openssl rand -base64 48
# This placeholder is intentionally rejected by production settings.
DJANGO_SECRET_KEY=change-me
# Hosts only, no scheme and no wildcard.
DJANGO_ALLOWED_HOSTS=mudaroba.com,www.mudaroba.com

# Origins include the scheme. Add only origins that really call the API.
CSRF_TRUSTED_ORIGINS=https://mudaroba.com,https://www.mudaroba.com
CORS_ALLOWED_ORIGINS=https://mudaroba.com,https://www.mudaroba.com

# Nginx preserves incoming X-Forwarded-Proto=https. This is trustworthy only
# behind Full (strict)/Tunnel with direct origin access restricted. Keep this
# safe profile until that proxy chain is verified; see DEPLOY.md.
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# After the strict-TLS prerequisites are verified, use for example:
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# SECURE_HSTS_PRELOAD=0

# === PostgreSQL and Redis ===
# Compose reads these values directly; DATABASE_URL must contain the same
# database, user and URL-encoded password.
POSTGRES_DB=pharmaturk
POSTGRES_USER=pharmaturk
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://pharmaturk:CHANGE_ME@postgres:5432/pharmaturk
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND_URL=redis://redis:6379/2
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
# Daily cleanup deletes only anonymous carts inactive for this many days.
ANONYMOUS_CART_TTL_DAYS=30
ANONYMOUS_CART_CLEANUP_BATCH_SIZE=500

# === Qdrant recommendations ===
# OpenSearch is not part of the current stack.
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Seed is opt-in. Set to 1 only for an intentional first population/recovery,
# then return it to 0 before normal restarts.
RUN_SEED_CATALOG=0
# Release tooling applies migrations once through the ops service.
RUN_MIGRATIONS=0
# Keep provider-side webhook mutation out of ordinary container restarts.
# Register it explicitly with manage.py in the intended environment.
REGISTER_TELEGRAM_WEBHOOK_ON_START=0

# === Public and internal URLs ===
# The checked-in Nginx serves frontend and /api on one origin.
NEXT_PUBLIC_SITE_URL=https://mudaroba.com
SITE_URL=https://mudaroba.com
FRONTEND_SITE_URL=https://mudaroba.com
# INTERNAL_API_BASE=http://backend:8000 is supplied by docker-compose.yml.

# === Cloudflare R2 media (optional for catalog media; required for PDF receipts) ===
USE_R2=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_USE_SSL=true
R2_PREFIX=
R2_BOTO_MAX_POOL_CONNECTIONS=64

# === OpenAI (optional) ===
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# === CoinRemitter (optional crypto payments) ===
# SITE_URL above generates this public callback:
# https://mudaroba.com/api/payments/crypto/webhook/
# The webhook body is reconciled through authenticated invoice/get; there is
# no shared webhook-secret contract in the current implementation.
COINREMITTER_API_KEY=
COINREMITTER_API_PASSWORD=
COINREMITTER_COIN=USDTTRC20
# Optional allowlist. Enable only after trusted-ingress real-IP normalization;
# otherwise Cloudflare makes $remote_addr an edge IP rather than provider IP.
COINREMITTER_WEBHOOK_IP_WHITELIST=
# Must remain 0; Django fails fast if enabled with DJANGO_DEBUG=0.
CRYPTO_DUMMY_MODE=0

# === Telegram notifications/login (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# Required (>=32 chars) whenever TELEGRAM_BOT_TOKEN is set; pass the same value
# as secret_token when calling Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Public variables are embedded during frontend image build.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# === Google and VK login (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
VK_APP_ID=
VK_APP_SECRET=
NEXT_PUBLIC_VK_APP_ID=
# VK Market sync is separate from VK login.
VK_YML_API=
VK_GROUP_ID=0
VK_USER_TOKEN=

# === Email (optional) ===
DEFAULT_FROM_EMAIL=no-reply@mudaroba.com
SERVER_EMAIL=no-reply@mudaroba.com
EMAIL_ADMIN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
EMAIL_API_TIMEOUT=15
# API alternatives supported by settings: sendgrid, smtp2go or resend.
EMAIL_API_PROVIDER=
EMAIL_API_FROM=
SENDGRID_API_KEY=
SMTP2GO_API_KEY=
RESEND_API_KEY=

# === Company data rendered in receipts/messages ===
COMPANY_NAME=Mudaroba
COMPANY_SUPPORT_EMAIL=support@mudaroba.com
COMPANY_SUPPORT_PHONE=
COMPANY_ADDRESS=
COMPANY_SITE_URL=https://mudaroba.com

# === Optional medicine media enrichment ===
SERPER_API_KEY=
MEDICINE_MEDIA_MIN_WIDTH=400
MEDICINE_MEDIA_MIN_HEIGHT=400
MEDICINE_MEDIA_MAX_PER_PRODUCT=3

# === Other optional integrations ===
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
VAPI_BASE_URL=https://api.vapi.co
VAPI_API_KEY=
# Separator: the empty key above must not consume the next setting in dotenv/scanners.
VAPI_DEFAULT_LANG=en
SCRAPER_PROXY_URL=
# PEM bundle CA провайдера, если прокси инспектирует TLS. verify=False запрещён.
SCRAPER_PROXY_CA_BUNDLE=

# FLO CAPTCHA transport. Paid Web Unlocker requests are permitted only from the
# product-card-open and cart-revalidate paths. Enable after a successful FLO canary.
FLO_WEB_UNLOCKER_ENABLED=false
BRIGHTDATA_WEB_UNLOCKER_API_KEY=
BRIGHTDATA_WEB_UNLOCKER_ZONE=
FLO_WEB_UNLOCKER_COUNTRY=tr
# FLO currently requires browser rendering to return the real page instead of CAPTCHA.
FLO_WEB_UNLOCKER_RENDER=true
# Keep empty. A product-only manual expect cannot distinguish FLO's legitimate
# removed-product category redirect from an unlock failure, and bills failed attempts.
# Parser-side CAPTCHA and exact-SKU checks still fail closed.
FLO_WEB_UNLOCKER_EXPECT_TEXT=
FLO_WEB_UNLOCKER_TIMEOUT_SECONDS=30
FLO_WEB_UNLOCKER_MAX_RESPONSE_BYTES=10485760

# === Supplier source-offer verification ===
# Safe rollout order: recording -> one-source verification -> card/cart -> catalog.
# Supplier background refresh is intentionally not registered or scheduled.
# Never enable verification with an empty allowlist; empty means every registered adapter.
SOURCE_OFFER_RECORDING_ENABLED=false
SOURCE_OFFER_DEFAULT_PRIORITY=100
SOURCE_OFFER_SOURCE_PRIORITIES={"zara":10,"bershka":10,"pullandbear":10,"massimodutti":10,"flo":20,"lcw":20,"ikea":20}
SOURCE_OFFER_VERIFICATION_ENABLED=false
SOURCE_OFFER_VERIFICATION_SOURCES=ikea
SOURCE_OFFER_REQUEST_TIMEOUT_SECONDS=5
SOURCE_OFFER_MAX_RETRIES=1
SOURCE_OFFER_RETRY_BACKOFF_SECONDS=0.1
SOURCE_OFFER_SUCCESS_CACHE_TTL=120
SOURCE_OFFER_ERROR_CACHE_TTL=15
SOURCE_OFFER_SINGLEFLIGHT_WAIT_SECONDS=0.5
SOURCE_OFFER_CIRCUIT_FAILURE_THRESHOLD=5
SOURCE_OFFER_CIRCUIT_RECOVERY_SECONDS=60
SOURCE_OFFER_DEFAULT_CONCURRENCY=4
SOURCE_OFFER_SOURCE_CONCURRENCY={"zara":2,"bershka":2,"pullandbear":2,"massimodutti":2}
SOURCE_OFFER_DEFAULT_RATE_PER_MINUTE=60
SOURCE_OFFER_SOURCE_RATE_PER_MINUTE={"zara":30,"bershka":30,"pullandbear":30,"massimodutti":30}
PRODUCT_CARD_SOURCE_REFRESH_ENABLED=false
PRODUCT_CARD_SOURCE_REFRESH_SOURCES=zara,bershka,pullandbear,massimodutti,flo,lcw,ikea,ummaland,akakce
PRODUCT_CARD_SOURCE_REFRESH_TIMEOUT_SECONDS=12
PRODUCT_CARD_SOURCE_REFRESH_MAX_RETRIES=1
PRODUCT_CARD_SOURCE_REFRESH_STATE_TTL_SECONDS=300
PRODUCT_CARD_SOURCE_REFRESH_ERROR_TTL_SECONDS=30
PRODUCT_CARD_SOURCE_REFRESH_LOCK_SECONDS=150
PRODUCT_CARD_SOURCE_REFRESH_MIN_PRICE_RATIO=0.05
PRODUCT_CARD_SOURCE_REFRESH_MAX_PRICE_RATIO=20
SOURCE_OFFER_CATALOG_PROJECTION_ENABLED=false
SOURCE_OFFER_CART_ENFORCEMENT_ENABLED=false
# Leave empty until a supplier integration provides an actual reservation guarantee.
SOURCE_OFFER_RESERVATION_CAPABLE_SOURCES=
SOURCE_OFFER_CART_REQUIRED_PRODUCT_TYPES=supplements
# Explicit real supplier stock adapters only; ilacfiyati is reference-price-only.
SUPPLEMENT_STOCK_ADAPTER_SOURCES=

# On-demand supplement reference-price observation (does not affect stock/cart).
SUPPLEMENT_MARKET_CHECK_ENABLED=false
SUPPLEMENT_MARKET_CHECK_SOURCES=ilacfiyati
SUPPLEMENT_MARKET_CHECK_FRESH_SECONDS=43200
SUPPLEMENT_MARKET_CHECK_ERROR_FRESH_SECONDS=300
SUPPLEMENT_MARKET_CHECK_STALE_RUNNING_SECONDS=180
SUPPLEMENT_MARKET_CHECK_ENQUEUE_LOCK_SECONDS=30
SUPPLEMENT_MARKET_CHECK_GLOBAL_RATE_PER_MINUTE=10
SUPPLEMENT_MARKET_CHECK_SOURCE_CONCURRENCY=2
SUPPLEMENT_MARKET_CHECK_REQUEST_TIMEOUT_SECONDS=15

# authenticated: any authenticated user; purchased: delivered-order buyer.
PRODUCT_REVIEW_ACCESS_POLICY=authenticated

# === Gunicorn ===
GUNICORN_WORKERS=4
GUNICORN_THREADS=8

# === Frontend analytics (embedded during build) ===
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_YM_ID=
